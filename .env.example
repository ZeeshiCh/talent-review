# Local development only
DATABASE_URL=postgresql+psycopg://hiring:hiring_local@localhost:5433/hiring
WEB_ORIGIN=http://localhost:3002

# OpenAI scoring — server only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=1
OPENAI_MAX_OUTPUT_TOKENS=1000

# Background scoring worker
WORKER_LEASE_SECONDS=300
WORKER_POLL_SECONDS=2
WORKER_RETRY_BASE_SECONDS=10
WORKER_RETRY_MAX_SECONDS=300
WORKER_RETRY_ATTEMPTS=3

# Candidate audio upload cap (20 MiB); private storage defaults to var/uploads/candidate-audio
CANDIDATE_MAX_AUDIO_BYTES=20971520

# Explicitly mocked local HR sign-in; set a private password in .env
HR_DEMO_EMAIL=hr@example.test
HR_DEMO_NAME=Demo HR Reviewer
HR_DEMO_PASSWORD=
HR_SESSION_HOURS=8
